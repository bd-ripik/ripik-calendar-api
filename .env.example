# Copy to .env for local work. Never commit real values.

# Microsoft Graph (Azure app "Ripik AI Telecalling Scheduler")
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Mailbox whose calendar receives demo bookings
USER_EMAIL=bd@ripik.ai

PORT=3000
DATABASE_URL=

# Retell. Use the API key with the "Webhook" badge: it is also used to verify
# that webhooks and tool calls really come from Retell.
RETELL_API_KEY=
RETELL_FROM_NUMBER=

# --- Safety switches ---------------------------------------------------
# The backend places no calls (callbacks, retries, demo recovery) unless this
# is exactly "true".
DIALING_ENABLED=false
# Leave unset in production. "false" turns off Retell signature checks.
# REQUIRE_RETELL_SIGNATURE=false

# --- Calling rules (defaults shown) ------------------------------------
# Automatic retries: weekdays, 11:00-17:00 in this zone (= business hours
# across the continental US).
# RETRY_WINDOW_TZ=America/New_York
# RETRY_WINDOW_START_HOUR=11
# RETRY_WINDOW_END_HOUR=17
# Skip automatic retries once a number has had this many calls in 7 days.
# MAX_CALLS_PER_NUMBER_7D=3
# Demo slots offered when the requested time is busy (prospect local time).
# DEMO_HOURS_START=9
# DEMO_HOURS_END=17
